# Developer switch: a public key in /boot/firmware/marqueet-ssh-key.pub
# turns on key-only SSH at boot; marqueet-ssh-off turns it off (devssh.sh).
[Unit]
Description=Marqueet developer SSH switch
# After cloud-init's first stage, which creates the Imager account. (Not
# cloud-final: that runs after multi-user.target, which waits for this unit,
# so systemd would drop this job to break the loop.)
After=local-fs.target cloud-init.service
ConditionPathExists=|/boot/firmware/marqueet-ssh-key.pub
ConditionPathExists=|/boot/firmware/marqueet-ssh-key.pub.txt
ConditionPathExists=|/boot/firmware/marqueet-ssh-off
ConditionPathExists=|/boot/firmware/marqueet-ssh-off.txt

[Service]
Type=oneshot
ExecStart=/bin/sh /boot/firmware/marqueet/devssh.sh

[Install]
WantedBy=multi-user.target
