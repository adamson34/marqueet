# Installs Marqueet on first boot; retries until the network is there.
[Unit]
Description=Install Marqueet (first boot)
After=network-online.target snapd.seeded.service
Wants=network-online.target
ConditionPathExists=!/var/lib/marqueet-installer/installed.sha256

[Service]
Type=oneshot
Environment=MARQUEET_YES=1
ExecStart=/bin/sh /boot/firmware/marqueet/install.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
