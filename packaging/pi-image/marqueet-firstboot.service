# Installs Marqueet on first boot, showing plain progress on the TV;
# firstboot.sh waits for the internet itself, and this retries on failure.
[Unit]
Description=Install Marqueet (first boot)
After=local-fs.target
ConditionPathExists=!/var/lib/marqueet-installer/installed.sha256

[Service]
Type=oneshot
ExecStart=/bin/sh /boot/firmware/marqueet/firstboot.sh
Restart=on-failure
RestartSec=60
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
